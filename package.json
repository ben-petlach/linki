{
  "name": "linki",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/mirror-ee.js",
    "dev": "next dev",
    "prebuild": "node scripts/mirror-ee.js",
    "build": "next build",
    "start": "node --import tsx scripts/start-server.mjs",
    "lint": "node scripts/lint-baseline.cjs",
    "mirror:ee": "node scripts/mirror-ee.js",
    "test:reliability": "node --import ./tests/setup.mjs --import tsx --test tests/reliability/*.test.ts",
    "test:integration": "node --import ./tests/setup.mjs --import tsx --test tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint:all": "eslint",
    "audit:security": "npm audit --audit-level=high",
    "test:dependencies": "node --test tests/dependency/*.test.mjs",
    "test:operations": "node --import ./tests/setup.mjs --import tsx --test tests/operations/*.test.ts",
    "db:backup": "node --import tsx scripts/backup-database.mjs",
    "db:restore": "node --import tsx scripts/restore-database.mjs"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "daisyui": "^5.5.19",
    "driver.js": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.40",
    "next": "16.4.2",
    "next-auth": "^4.24.15",
    "openai": "^6.34.0",
    "papaparse": "^5.5.3",
    "playwright": "1.64.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "zod": "^4.4.3",
    "imap": "^0.8.19",
    "nodemailer": "^10.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "smtp-server": "^3.19.23",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "@types/imap": "^0.8.43",
    "fast-glob": "file:vendor/fast-glob"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "overrides": {
    "utf7": {
      "semver": "5.7.2"
    },
    "next-auth": {
      "nodemailer": "10.1.2"
    },
    "@next/eslint-plugin-next": {
      "fast-glob": "$fast-glob"
    }
  }
}
